# Keep the production file private (chmod 600 .env). Use URL-safe password characters.
POSTGRES_PASSWORD=replace-with-long-url-safe-secret
NEWS_ADMIN_TOKEN=replace-with-unique-long-admin-token
NEWS_EDITOR_TOKEN=replace-with-unique-long-editor-token
NEWS_PUBLIC_BASE_URL=https://news.example.org

# Normal scheduling and publication are automatic when all evidence and rights gates pass.
# Set either of these to true to pause publication; use NEWS_FIXTURE_MODE=true only offline.
NEWS_DRAFT_ONLY=false
NEWS_PUBLICATION_PAUSED=false
NEWS_GEO_REGISTER_ID=fixture-2026-demo
NEWS_LLM_PROVIDER=fake
NEWS_SOURCE_CATALOG_PATH=fixtures/source_catalog.json

# Configure these only after source, endpoint, and model-processing rights are reviewed.
# NEWS_LLM_PROVIDER=openai_compatible
# NEWS_LLM_ENDPOINT=https://approved-model.example.org/v1/chat/completions
# NEWS_LLM_API_KEY=replace-with-secret
# NEWS_LLM_MODEL=reviewed-model
# NEWS_DAILY_SPEND_LIMIT_USD=10
# NEWS_INPUT_COST_PER_MILLION=0.50
# NEWS_OUTPUT_COST_PER_MILLION=1.50