# Copy to .env, choose random secrets, and keep it private (chmod 600 .env).
POSTGRES_PASSWORD=replace-with-long-url-safe-secret
NEWS_ADMIN_TOKEN=replace-with-unique-long-admin-token
NEWS_EDITOR_TOKEN=replace-with-unique-long-editor-token
NEWS_PUBLIC_BASE_URL=https://news.example.org
NEWS_PUBLISHER_NAME=Κοσμοροή
NEWS_GEO_REGISTER_ID=world-geonames-3.0.2
NEWS_SOURCE_CATALOG_PATH=fixtures/source_catalog.json

# News is collected from public HTML only. No news API or RSS account is used.
NEWS_PUBLIC_HTML_ENABLED=true
NEWS_AUTO_DISCOVER_PUBLISHERS=true
NEWS_LLM_PROVIDER=openai
NEWS_LLM_API_KEY=replace-with-your-ai-model-key
NEWS_LLM_MODEL=gpt-5.4-mini
NEWS_LLM_ENDPOINT=https://api.openai.com/v1/responses
NEWS_REASONING_EFFORT=low
# This uses the AI provider's search tool, not a publisher/news API.
NEWS_WEB_SEARCH_ENABLED=true
NEWS_WEB_SEARCH_DAILY_LIMIT=8
NEWS_WEB_SEARCH_INTERVAL_MINUTES=180

# Automatic processing; set these true only to pause operation.
NEWS_FIXTURE_MODE=false
NEWS_DRAFT_ONLY=false
NEWS_PUBLICATION_PAUSED=false
NEWS_DAILY_GENERATION_LIMIT=100
NEWS_DAILY_CALL_LIMIT=600
NEWS_DAILY_TOKEN_LIMIT=4000000
NEWS_DAILY_SPEND_LIMIT_USD=10
# Published model prices at implementation; update when changing model/prices.
NEWS_INPUT_COST_PER_MILLION=0.75
NEWS_OUTPUT_COST_PER_MILLION=4.50
NEWS_WEB_SEARCH_CALL_COST_USD=0.01
NEWS_CRAWL_DELAY_SECONDS=2
NEWS_RAW_TEXT_RETENTION_DAYS=7

# Optional in-process local AI instead of an AI API:
# INSTALL_LOCAL_AI=true
# NEWS_LLM_PROVIDER=llama_cpp
# NEWS_LLM_MODEL=your-installed-model
# NEWS_MODEL_PATH=/models/news.gguf
# NEWS_MODEL_SHA256=expected-file-sha256
# NEWS_WEB_SEARCH_ENABLED=false
# NEWS_MODEL_CONTEXT_TOKENS=32768
# NEWS_MODEL_GPU_LAYERS=0
